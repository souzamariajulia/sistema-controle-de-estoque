# Copie para .env antes de subir o docker: cp .env.example .env

# --- MySQL (container) ---
DB_ROOT_PASSWORD=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Porta exposta no host (troque para 3307 se ja existir um MySQL local na 3306)
DB_PORT=

# --- Adminer ---
ADMINER_PORT=

# --- Conexao da aplicacao (usada pela camada de backend) ---
# Dentro do docker o host é "db"; rodando o PHP fora do docker, use 127.0.0.1
DB_HOST=
DB_CHARSET=

# --- CORS (origem do frontend, para o backend liberar as chamadas fetch) ---
FRONTEND_URL=
